# Copy to .env and fill in. Never commit .env.

# --- Required ---
ESPOCRM_DATABASE_PASSWORD=
ESPOCRM_DATABASE_ROOT_PASSWORD=
# Public URLs, as users reach them.
ESPOCRM_SITE_URL=https://crm.example.com
ESPOCRM_WEBSOCKET_URL=wss://crm.example.com/ws
# Only used on the first install. Change it in the app afterwards.
ESPOCRM_ADMIN_PASSWORD=

# --- Optional ---
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_LANGUAGE=en_US
ESPOCRM_TIME_ZONE=UTC

# Host name for the Caddy HTTPS proxy (docker compose --profile https up -d).
ESPOCRM_DOMAIN=crm.example.com
# ESPOCRM_PUBLIC_HTTP_PORT=80
# ESPOCRM_PUBLIC_HTTPS_PORT=443

# Loopback ports of the app and the websocket server, to use with your own reverse proxy.
# ESPOCRM_APP_PORT=8080
# ESPOCRM_WEBSOCKET_PORT=8081
